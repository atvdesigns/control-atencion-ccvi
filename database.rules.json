{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "centers": {
      "$centerId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('enabled').val() === true && root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('centerAccess').child($centerId).val() === true",
        ".write": "auth != null && root.child('users').child(auth.uid).child('enabled').val() === true && root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('centerAccess').child($centerId).val() === true"
      }
    },
    "days": {
      "$centerId": {
        "$dayId": {
          ".read": "auth != null && root.child('users').child(auth.uid).exists() && root.child('users').child(auth.uid).child('enabled').val() === true && root.child('users').child(auth.uid).child('centerAccess').child($centerId).val() === true && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'operator-window-1' || root.child('users').child(auth.uid).child('role').val() === 'operator-window-2' || root.child('users').child(auth.uid).child('role').val() === 'cashier')",
          ".write": "auth != null && root.child('users').child(auth.uid).exists() && root.child('users').child(auth.uid).child('enabled').val() === true && root.child('users').child(auth.uid).child('centerAccess').child($centerId).val() === true && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'operator-window-1' || root.child('users').child(auth.uid).child('role').val() === 'operator-window-2' || root.child('users').child(auth.uid).child('role').val() === 'cashier')"
        }
      }
    },
    "public": {
      "turns": {
        "$publicToken": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).exists() && root.child('users').child(auth.uid).child('enabled').val() === true && newData.hasChild('centerId') && newData.child('centerId').isString() && root.child('users').child(auth.uid).child('centerAccess').child(newData.child('centerId').val()).val() === true && (!data.exists() || !data.child('centerId').exists() || data.child('centerId').val() === newData.child('centerId').val()) && (root.child('users').child(auth.uid).child('role').val() === 'operator-window-1' || root.child('users').child(auth.uid).child('role').val() === 'operator-window-2' || root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      },
      "displays": {
        "$centerId": {
          "$dayId": {
            ".read": true,
            ".write": "auth != null && root.child('users').child(auth.uid).exists() && root.child('users').child(auth.uid).child('enabled').val() === true && root.child('users').child(auth.uid).child('centerAccess').child($centerId).val() === true && (root.child('users').child(auth.uid).child('role').val() === 'operator-window-1' || root.child('users').child(auth.uid).child('role').val() === 'operator-window-2' || root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
          }
        }
      },
      "displayCalls": {
        "$centerId": {
          "$dayId": {
            ".read": true,
            "$eventId": {
              ".write": "auth != null && root.child('users').child(auth.uid).exists() && root.child('users').child(auth.uid).child('enabled').val() === true && root.child('users').child(auth.uid).child('centerAccess').child($centerId).val() === true && (root.child('users').child(auth.uid).child('role').val() === 'operator-window-1' || root.child('users').child(auth.uid).child('role').val() === 'operator-window-2' || root.child('users').child(auth.uid).child('role').val() === 'cashier' || root.child('users').child(auth.uid).child('role').val() === 'admin') && !data.exists() && newData.hasChildren(['publicCode', 'isPriority', 'destinationType', 'destinationLabel', 'calledAt'])"
            }
          }
        }
      },
      "kiosks": {
        "$centerId": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('enabled').val() === true && root.child('users').child(auth.uid).child('role').val() === 'admin' && root.child('users').child(auth.uid).child('centerAccess').child($centerId).val() === true"
        }
      }
    }
  }
}
